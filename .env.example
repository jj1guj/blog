# コピーして .env を作り、値を書き換えてください:  cp .env.example .env

# ドメイン（どちらも Cloudflare 管理のドメインのサブドメインにする）
BLOG_DOMAIN=blog.example.com
STATS_DOMAIN=stats.example.com

# Fediverse 上のブログアカウント名 → @blog@blog.example.com になる
FEDI_USERNAME=blog

TZ=Asia/Tokyo

# ホストで待ち受けるポート（127.0.0.1 のみ）。cloudflared の転送先と合わせる
# ブログ（Madblog）
BLOG_PORT=28080
# GoatCounter
STATS_PORT=28081
