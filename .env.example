# ローカル確認用の仮ドメイン。本番では実際のドメインに変更してください。
BLOG_DOMAIN=example.com
STATS_DOMAIN=stats.example.com

# ホスト側に公開するポート。127.0.0.1 からのみ接続できます。
CADDY_PORT=28080
STATS_PORT=28081

# Hugo、Caddy、自動投稿が共通で使う URL。Caddy はこの URL のスキームを Hollo に伝えます。
# 空欄なら compose.dev.yml ではローカル URL、通常の compose.yml では https://BLOG_DOMAIN を使います。
# localhost での投稿確認では http://localhost:28080 などを指定します。末尾の / は付けません。
BLOG_URL=

# 起動前に、必ず十分に強い値へ変更してください。
# POSTGRES_PASSWORD は DATABASE_URL 内で使うため、英数字のみを推奨します。
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password
HOLLO_SECRET_KEY=replace-with-a-random-secret-key-of-at-least-44-characters

# 自動投稿の記事内に数式やチェックリストがある場合は、それぞれ math、tasklist が必要です。
HOLLO_MARKDOWN_EXTENSIONS=math,tasklist

# OAuth で発行したトークンを設定します。未設定では投稿されません。
HOLLO_ACCESS_TOKEN=

# 通常構成では自動投稿が有効です。開発用 Compose では無効になります。
PUBLISH_ENABLED=true
# 初回起動時に既存記事を投稿する場合のみ true にします。
PUBLISH_EXISTING_ON_FIRST_RUN=false

# ローカルの Misskey などとの連合確認用（compose.dev.yml）。Misskey のポートを指定します。
LOCAL_FEDIVERSE_PORT=61812
# 連合確認用プロキシ（tools/local-fediverse-proxy.cjs）の待受ポート。docs/local-federation.md を参照。
LOCAL_PROXY_PORT=28083
