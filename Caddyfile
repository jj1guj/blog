:80 {
	route {
		map {env.BLOG_URL} {blog_scheme} {
			~(?i)^https:// https
			~(?i)^http:// http
			default invalid
		}

		handle_path /gc/* {
			reverse_proxy goatcounter:8080 {
				header_up Host {$STATS_DOMAIN}
			}
		}

		handle /fediverse/posts.json {
			rewrite * /posts.json
			root * /var/lib/blog
			file_server
		}

		@hugo file {
			root /srv
			try_files {path} {path}/index.html
		}
		handle @hugo {
			root * /srv
			try_files {path} {path}/index.html
			file_server
		}

		handle {
			@invalid_scheme expression `{blog_scheme} == "invalid"`
			respond @invalid_scheme "BLOG_URL must start with http:// or https://" 500
			reverse_proxy hollo:3000 {
				header_up X-Forwarded-Proto {blog_scheme}
			}
		}
	}
}
